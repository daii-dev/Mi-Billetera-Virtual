{
  "expo": {
    "name": "Mi Billetera Virtual",
    "slug": "mi-billetera-virtual",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/logo-app.png",
    "scheme": "mibilleteravirtual",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/logo-app.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFFFF"
    },
    "plugins": [
      "expo-secure-store",
      "@react-native-community/datetimepicker",
      "expo-router",
      "expo-asset"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.billeteravirtual.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-logo.png",
        "backgroundColor": "#002381"
      }
    }
  }
}
